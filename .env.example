# ========================================================
# Bela Mitra – AI Crop Doctor & Weather Advisory Platform
# Environment Configuration Template (.env.example)
# ========================================================

# Open-Meteo Weather API
# Open-Meteo is free for non-commercial and agricultural use. No API key required.
# Live forecast and geocoding endpoints:
# https://api.open-meteo.com/v1/forecast
# https://geocoding-api.open-meteo.com/v1/search

# Optional: Groq LLM API Key (for multimodal report generation and chatbot)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Backend Service Port & Host
PORT=8000
HOST=127.0.0.1

# Frontend API URL (for production deployment e.g. on Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000
